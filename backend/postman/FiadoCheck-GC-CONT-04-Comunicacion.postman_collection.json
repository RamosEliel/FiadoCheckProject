    {
      "name": "04-A — mora de un día: comparar el aviso con el fiado",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const avisos = JSON.parse(pm.collectionVariables.get('avisos') || '[]');",
              "const b = pm.response.json();",
              "const aviso = avisos.find(function (a) { return String(a.id_credito) === pm.collectionVariables.get('idCredito_04A'); });",
              "pm.test('04-A — existe un aviso para el fiado en la primera consulta del día', function () { pm.expect(aviso, 'no hay aviso').to.not.be.undefined; });",
