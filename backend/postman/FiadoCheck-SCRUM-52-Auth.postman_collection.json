          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Prerequisito — GET /health responde 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Prerequisito — status ok', function () {",
              "    pm.expect(pm.response.json().status).to.eql('ok');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{hostUrl}}/health", "host": ["{{hostUrl}}"], "path": ["health"] }
      }
    },
    {
      "name": "AUTH-01a — registerTendero campos completos → 201",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Identificador único por corrida: evita choques de email y cédula.",
              "const ts = Date.now().toString().slice(-9);",
              "pm.collectionVariables.set('runId', ts);",
              "pm.collectionVariables.set('tenderoEmail', 'tendero.' + ts + '@test.fiadocheck.com');",
              "pm.collectionVariables.set('tenderoCedula', ts);",
              "pm.collectionVariables.set('clienteEmail', 'cliente.' + ts + '@test.fiadocheck.com');",
              "pm.collectionVariables.set('clienteCedula', (Number(ts) + 1).toString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('AUTH-01 — registro de tendero con campos completos devuelve 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('AUTH-01 — mensaje de confirmación', function () {",
              "    pm.expect(pm.response.json().message).to.include('Tendero registrado');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre_completo\": \"Tendero Prueba {{runId}}\",\n  \"email\": \"{{tenderoEmail}}\",\n  \"telefono\": \"3001234567\",\n  \"cedula\": \"{{tenderoCedula}}\",\n  \"direccion\": \"Calle 10 # 20-30\",\n  \"num_camara_comercio\": \"CC-{{runId}}\",\n  \"password\": \"{{tenderoPassword}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/auth/registerTendero", "host": ["{{baseUrl}}"], "path": ["auth", "registerTendero"] }
      }
    },
