            "clientes",
            "{{clienteCedula}}"
          ]
        }
      }
    },
    {
      "name": "Corte 1, detalle de cartera del tendero",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const TOL = 0.01;",
              "pm.test('Corte 1 — el detalle responde 200', function () { pm.response.to.have.status(200); });",
              "const b = pm.response.json();",
              "const abiertos = b.creditos.filter(function (c) { return c.estado !== 'pagado'; });",
              "const suma = abiertos.reduce(function (s, c) { return s + c.saldo_pendiente; }, 0);",
              "const deudaCliente = Number(pm.collectionVariables.get('deudaCliente1'));",
              "pm.test('06-B — la suma de saldos no saldados del detalle = total que vio el cliente (±$0,01)', function () {",
              "    pm.expect(Math.abs(suma - deudaCliente), 'suma=' + suma + ' cliente=' + deudaCliente).to.be.at.most(TOL);",
              "});",
              "pm.test('06-B — el fiado ya pagado (C) no aumenta la deuda: está en cero', function () {",
              "    const c = b.creditos.find(function (x) { return String(x.id_credito) === pm.collectionVariables.get('idC'); });",
              "    pm.expect(c.saldo_pendiente).to.eql(0);",
              "});"
            ]
          }
        }
      ],
