    {
      "name": "Corte 1, el acreedor — ficha del cliente del tendero",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const TOL = 0.01;",
              "pm.test('Corte 1 — la ficha responde 200', function () { pm.response.to.have.status(200); });",
              "const deudaTendero = pm.response.json().totales.total_deuda;",
              "const deudaCliente = Number(pm.collectionVariables.get('deudaCliente1'));",
              "pm.collectionVariables.set('deudaTendero1', String(deudaTendero));",
              "pm.test('06-A — total que ve el cliente = deuda que ve el tendero (±$0,01)', function () {",
              "    pm.expect(Math.abs(deudaCliente - deudaTendero)).to.be.at.most(TOL);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
