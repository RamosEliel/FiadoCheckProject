    {
      "name": "03-A — Copiar el tope del momento (cliente con historial)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('03-A — la recomendación responde 200 (un 503 es la herramienta de riesgo caída: no se ejecuta el caso ni se inventa el límite)', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const b = pm.response.json();",
              "pm.test('03-A — estado con_historial', function () { pm.expect(b.estado).to.eql('con_historial'); });",
              "const lim = Number(b.limite_sugerido);",
              "pm.test('03-A — límite sugerido entre 1 y 300000 (precondición del caso)', function () {",
              "    pm.expect(lim).to.be.above(0);",
              "    pm.expect(lim).to.be.at.most(300000);",
              "});",
              "// El límite se copia ahora y no se vuelve a consultar para clasificar.",
              "pm.collectionVariables.set('limiteH', String(lim));",
              "console.log('Tope copiado:', lim, '| nivel:', b.nivel_riesgo, '| hora:', new Date().toISOString());"
            ]
          }
        }
      ],
      "request": {
