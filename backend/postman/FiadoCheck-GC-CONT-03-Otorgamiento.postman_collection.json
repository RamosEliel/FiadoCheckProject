          "raw": "{{baseUrl}}/creditos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "creditos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clienteId\": {{clienteCedula}},\n  \"montoTotal\": {{montoIntentado}},\n  \"fechaLimitePago\": \"{{fechaLimite}}\",\n  \"descripcion\": \"GC-CONT-03 cumplio\"\n}"
        }
      }
    },
    {
      "name": "03-A — Leer el valor guardado y clasificar",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b = pm.response.json();",
              "const limite = Number(pm.collectionVariables.get('limiteH'));",
              "const intentado = Number(pm.collectionVariables.get('montoIntentado'));",
              "pm.test('03-A — el valor guardado es el que se escribió', function () { pm.expect(b.monto_total).to.eql(intentado); });",
              "const clasificacion = b.monto_total <= limite ? 'cumplio' : 'excepcion';",
              "pm.test('03-A — clasificación: cumplio', function () { pm.expect(clasificacion).to.eql('cumplio'); });",
              "",
              "",
              "const fila = { caso: '03-A', cliente: pm.collectionVariables.get('clienteCedula'),",
              "  limite: Number(pm.collectionVariables.get('limiteH')), valor_intentado: Number(pm.collectionVariables.get('montoIntentado')),",
              "  valor_guardado: b.monto_total, clasificacion: clasificacion, diferencia: b.monto_total - Number(pm.collectionVariables.get('limiteH')),",
              "  id_credito: b.id_credito };",
              "const p = JSON.parse(pm.collectionVariables.get('planilla') || '[]'); p.push(fila);",
              "pm.collectionVariables.set('planilla', JSON.stringify(p));",
              "console.log('PLANILLA', JSON.stringify(fila));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenTendero}}"
          }
