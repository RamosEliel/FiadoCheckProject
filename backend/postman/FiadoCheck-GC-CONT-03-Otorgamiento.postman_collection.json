    {
      "name": "03-B — Leer el valor guardado y clasificar",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b = pm.response.json();",
              "const limite = Number(pm.collectionVariables.get('limiteH'));",
              "const intentado = Number(pm.collectionVariables.get('montoIntentado'));",
              "pm.test('03-B — el valor guardado es el que se escribió', function () { pm.expect(b.monto_total).to.eql(intentado); });",
