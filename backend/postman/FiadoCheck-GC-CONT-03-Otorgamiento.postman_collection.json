    {
      "name": "03-A — Fiar exactamente el tope",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function hoyBogota() { return new Date(Date.now() - 5 * 3600 * 1000).toISOString().slice(0, 10); }",
              "function sumarDias(clave, n) { const p = clave.split('-').map(Number); return new Date(Date.UTC(p[0], p[1] - 1, p[2] + n)).toISOString().slice(0, 10); }",
              "function diasEntre(desde, hasta) { const a = desde.split('-').map(Number), b = hasta.split('-').map(Number); return Math.round((Date.UTC(b[0], b[1] - 1, b[2]) - Date.UTC(a[0], a[1] - 1, a[2])) / 86400000); }",
              "const limite = Number(pm.collectionVariables.get('limiteH'));",
              "const monto = limite;",
              "pm.collectionVariables.set('montoIntentado', String(monto));",
              "pm.collectionVariables.set('fechaLimite', sumarDias(hoyBogota(), 15));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('03-A — el fiado queda guardado (201); la recomendación orienta, no impide', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.collectionVariables.set('idCreditoCaso', String(pm.response.json().id_credito));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
